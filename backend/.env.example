# Copie este arquivo para .env e preencha os valores reais.
# .env nunca deve ser commitado (ver .gitignore).

# Gere uma chave forte, ex: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# postgres://usuario:senha@host:5432/nome_do_banco
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sistema_pedidos

# Usado apenas em config.settings.prod
DJANGO_ALLOWED_HOSTS=api.seudominio.com

# Origens permitidas do frontend (Next.js). Múltiplas origens separadas por vírgula.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Object storage (S3-compatible, ex: Cloudflare R2) — usado apenas em config.settings.prod
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=auto
AWS_S3_CUSTOM_DOMAIN=

# Mercado Pago
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_URL=https://api.seudominio.com/api/payments/webhook/mercadopago/
MERCADO_PAGO_CLIENT_ID=
MERCADO_PAGO_OAUTH_REDIRECT_URI=https://api.seudominio.com/api/payment-account/callback/
